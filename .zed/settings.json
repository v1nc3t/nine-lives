{
  // Zed reloads a file from disk only while its buffer has no unsaved edits.
  // Saving shortly after every edit keeps buffers clean so outside changes show up.
  "autosave": { "after_delay": { "milliseconds": 1000 } },
  "lsp": {
    "clangd": {
      "binary": {
        // Lets clangd ask the Xtensa GCC for its system include paths
        "arguments": ["--query-driver=**/xtensa-esp32s3-elf-*"]
      }
    }
  }
}
